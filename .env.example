# Convex guest authentication and hosted AI: npx convex dev configures ignored .env.local.
# Set OPENAI_API_KEY in the Convex deployment, not a VITE_ variable.
# DRILLY_MODEL is optional; it defaults to gpt-6-astra.
# CONVEX_DEPLOYMENT=dev:your-development-deployment
# VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
