# Convex guest saves and hosted AI: npx convex dev configures ignored .env.local.
# Set OPENAI_API_KEY in the Convex deployment, not a VITE_ variable.
# DRILLY_MODEL is optional; it defaults to gpt-6-astra.
# CONVEX_DEPLOYMENT=dev:your-development-deployment
# VITE_CONVEX_URL=https://your-development-deployment.convex.cloud

# Optional CLI/local AI without Convex: add these to ignored .env.local and restart Vite.
# These values stay on the development server. Never prefix secrets with VITE_.
OPENAI_API_KEY=
DRILLY_MODEL=gpt-6-astra
